<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PromptMeUp</RootNamespace>
    <AssemblyName>hm</AssemblyName>
    <PackageId>PromptMeUp.Cli</PackageId>
    <Version>0.1.5</Version>
    <Authors>Umberto Giacobbi</Authors>
    <Description>Ask from the terminal, understand the answer, and explicitly approve every command before it runs.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/umbertotechnopreneur/PromptMeUp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ai;cli;openai;assistant;terminal</PackageTags>
    <NeutralLanguage>en</NeutralLanguage>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\prompt\*.yaml" Link="prompt\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\scripts\hm-path.ps1" Link="hm-path.ps1" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\scripts\hm-path.sh" Link="hm-path.sh" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
